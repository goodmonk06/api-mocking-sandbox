{
  "name": "backend",
  "version": "1.0.0",
  "description": "API mocking backend with Fastify",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "tsc --noEmit",
    "db:setup": "prisma generate && prisma migrate dev",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.7.1",
    "fastify": "^4.25.2",
    "fastify-type-provider-zod": "^2.0.0",
    "openapi-types": "^12.1.3",
    "js-yaml": "^4.1.0",
    "json-schema-faker": "^0.5.6",
    "@types/json-schema": "^7.0.15",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
